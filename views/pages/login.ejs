<%- include('../templates/header') %>

<div class="container mt-5" style="min-height: 100vh;">
    <h1 class="auth-heading d-flex justify-content-center" href="#">GoPlay</h1>
  <div class="d-flex justify-content-center">
<div class="card login-card" style="width: 23rem;">
  <div class="card-body">
    <h5 class="card-title">Login</h5>
    <p class="card-text">Sign in to your account.</p>

    <% if (error) { %>
    <div class="alert alert-danger">
        <%= error %>
    </div>
    <% } %>

    <form action="/login" method="POST">
  <div class="mb-3">
    <label for="user" class="form-label">Username</label>
    <input type="text" class="form-control" pattern="^[a-zA-Z0-9_]{3,20}$" name="username" id="user" required>
  </div>
  <div class="mb-3">
    <label for="pass" class="form-label">Password</label>
    <input type="password" class="form-control" name="password" id="pass" required>
  </div>
  <button type="submit" class="btn btn-secondary buttons">Submit</button>
</form>
    <a href="/signup">Don't have an account? Sign Up</a>
  </div>
</div>
</div>
</div>

<%- include('../templates/footer') %>