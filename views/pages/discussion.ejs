<%- include("../templates/header") %>

<%- include("../templates/navbar") %>

<div class="content">

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h1 class="display-6">

                <%= discussion.title %>

            </h1>

            <p class="text-muted">

                Posted by
                <strong><%= discussion.authorName %></strong>

                •

                <%= discussion.createdAt.toLocaleDateString() %>

            </p>

            <hr>

            <p>

                <%= discussion.description %>

            </p>

        </div>

    </div>

    <h3>Replies</h3>

    <% if (replies.length === 0) { %>

        <div class="alert alert-secondary">

            No replies yet.
            Start the conversation!

        </div>

    <% } else { %>

        <% replies.forEach(reply => { %>

            <div class="card mb-3">

                <div class="card-body">

                    <strong><%= reply.authorName %></strong>

                    <small class="text-muted">

                        •
                        <%= reply.createdAt.toLocaleDateString() %>

                    </small>

                    <hr>

                    <p><%= reply.message %></p>

                </div>

            </div>

        <% }) %>

    <% } %>

    <h3 class="mt-5">

    Add Reply

    </h3>

    <form action="/discussion/<%= discussion._id %>/reply" method="POST">
        <textarea
            class="form-control"
            name="message"
            rows="4"
            max-length="1000"
            placeholder="Write your reply..."
            required
        ></textarea>

        <button
        type="submit"
        class="btn btn-primary mt-3">

        Reply

        </button>

    </form>

</div>

<%- include("../templates/footer") %>