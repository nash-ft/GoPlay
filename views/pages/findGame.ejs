<%- include("../templates/header") %>

<%- include("../templates/navbar") %>

<div class="content">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="display-6">
                Find a Game
            </h1>

            <p>
                Find people to play sports with.
            </p>
        </div>

        <a href="/games/new" class="btn btn-primary">
            + Create Game
        </a>

    </div>

    <% if (games.length === 0) { %>

        <div class="alert alert-secondary">
            No games available right now. Be the first to create one!
        </div>

    <% } else { %>

        <div class="row g-4">

            <% games.forEach(game => { %>

                <div class="col-lg-4 col-md-6">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h4>
                                <%= game.title %>
                            </h4>

                            <p class="text-muted mb-2">
                                <%= game.sport %>
                            </p>

                            <p>
                                📍 <%= game.location %>
                            </p>

                            <p>
                                📅 <%= game.date %>
                            </p>

                            <p>
                                🕐 <%= game.time %>
                            </p>

                            <p>
                                👥
                                <%= game.players.length %>
                                /
                                <%= game.maxPlayers %>
                                players
                            </p>

                            <a
                                href="/games/<%= game._id %>"
                                class="btn btn-outline-primary">

                                View Game

                            </a>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>

<%- include("../templates/footer") %>