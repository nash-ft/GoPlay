<%- include("../templates/header") %>

<%- include("../templates/navbar") %>

<div class="content">

    <div class="card shadow-sm">

        <div class="card-body p-4 p-md-5">

            <h1 class="display-6 mb-4">
                Edit Game
            </h1>

            <% if (error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
            <% } %>

            <form
                action="/games/<%= game._id %>/edit"
                method="POST">

                <div class="mb-3">

                    <label class="form-label">
                        Game Title
                    </label>

                    <input
                        type="text"
                        name="title"
                        class="form-control"
                        value="<%= game.title %>"
                        maxlength="100"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Sport
                    </label>

                    <select
                        name="sport"
                        class="form-select"
                        required>

                        <option value="Soccer" <%= game.sport === "Soccer" ? "selected" : "" %>>
                            Soccer
                        </option>

                        <option value="Basketball" <%= game.sport === "Basketball" ? "selected" : "" %>>
                            Basketball
                        </option>

                        <option value="Tennis" <%= game.sport === "Tennis" ? "selected" : "" %>>
                            Tennis
                        </option>

                        <option value="Baseball" <%= game.sport === "Baseball" ? "selected" : "" %>>
                            Baseball
                        </option>

                        <option value="Volleyball" <%= game.sport === "Volleyball" ? "selected" : "" %>>
                            Volleyball
                        </option>

                        <option value="Golf" <%= game.sport === "Golf" ? "selected" : "" %>>
                            Golf
                        </option>

                        <option value="Swimming" <%= game.sport === "Swimming" ? "selected" : "" %>>
                            Swimming
                        </option>

                        <option value="Running" <%= game.sport === "Running" ? "selected" : "" %>>
                            Running
                        </option>

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Location
                    </label>

                    <input
                        type="text"
                        name="location"
                        class="form-control"
                        value="<%= game.location %>"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Date
                    </label>

                    <input
                        type="date"
                        name="date"
                        class="form-control"
                        value="<%= game.date %>"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Time
                    </label>

                    <input
                        type="time"
                        name="time"
                        class="form-control"
                        value="<%= game.time %>"
                        required>

                </div>

                <div class="mb-4">

                    <label class="form-label">
                        Maximum Players
                    </label>

                    <input
                        type="number"
                        name="maxPlayers"
                        class="form-control"
                        value="<%= game.maxPlayers %>"
                        min="<%= game.players.length %>"
                        required>

                </div>

                <div class="d-flex gap-2">

                    <button
                        type="submit"
                        class="btn btn-primary">

                        Save Changes

                    </button>

                    <a
                        href="/games/<%= game._id %>"
                        class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<%- include("../templates/footer") %>