<%- include('../templates/header') %>

<%- include('../templates/navbar') %>

<link
  href="https://unpkg.com/maplibre-gl@5.6.2/dist/maplibre-gl.css"
  rel="stylesheet"
/>

<div id="map-container">
  <div id="map"></div>

  <div id="map-toolbar">
    <div id="search-container" class="input-group mb-3">
      <input
        id="search-input"
        class="form-control"
        type="text"
        placeholder="Search city or sports facility"
      />

      <button
        id="clear-search"
        class="btn btn-outline-secondary d-none"
        type="button">
        <i class="bi bi-x-lg"></i>
    </button>

      <button id="search-button" class="btn btn-primary">
        <i class="bi bi-search"></i>
      </button>

      <div id="search-results"></div>
    </div>

    <div id="filter-buttons">
      <button data-type="all">All</button>

      <button data-type="soccer">
        <img src="/images/markers/soccer.png" alt="" />
        Soccer
      </button>

      <button data-type="basketball">
        <img src="/images/markers/basketball.png" alt="" />
        Basketball
      </button>

      <button data-type="tennis">
        <img src="/images/markers/tennis.png" alt="" />
        Tennis
      </button>

      <button data-type="baseball">
        <img src="/images/markers/baseball.png" alt="" />
        Baseball
      </button>

      <button data-type="golf">
        <img src="/images/markers/golf.png" alt="" />
        Golf
      </button>

      <button data-type="swimming">
        <img src="/images/markers/swimming.png" alt="" />
        Swimming
      </button>

      <button data-type="volleyball">
        <img src="/images/markers/volleyball.png" alt="" />
        Volleyball
      </button>

      <button data-type="gym">
        <img src="/images/markers/gym.png" alt="" />
        Gym
      </button>
    </div>
  </div>
</div>

<script src="https://unpkg.com/maplibre-gl@5.6.2/dist/maplibre-gl.js"></script>
<script src="/js/map.js"></script>

<%- include('../templates/footer') %>
