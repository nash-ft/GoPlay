<%- include("../templates/header") %>

<%- include("../templates/navbar") %>

<div class="content">

    <div class="card shadow-sm">

        <div class="card-body p-4 p-md-5">

            <div class="d-flex justify-content-between align-items-start">

                <div>

                    <span class="badge bg-primary mb-2">
                        <%= game.sport %>
                    </span>

                    <h1 class="display-6">
                        <%= game.title %>
                    </h1>

                </div>

            </div>

            <hr>

            <div class="mb-4">

                <p>
                    📍 <strong>Location</strong><br>
                    <%= game.location %>
                </p>

                <p>
                    📅 <strong>Date</strong><br>
                    <%= game.date %>
                </p>

                <p>
                    🕐 <strong>Time</strong><br>
                    <%= game.time %>
                </p>

                <p>
                    👥 <strong>Players</strong><br>
                    <%= game.players.length %> / <%= game.maxPlayers %>
                </p>

            </div>

            <h3 class="mb-3">
                Players
            </h3>

            <% if (game.players.length === 0) { %>

                <p class="text-muted">
                    No players have joined yet.
                </p>

            <% } else { %>

                <div class="mb-4">

                    <% players.forEach(player => { %>

                        <span class="badge bg-light text-dark border me-2 mb-2 p-2">
                            👤 <%= player.username %>
                        </span>

                    <% }) %>

                </div>

            <% } %>

            <div class="d-flex gap-2">

                <% const userJoined = game.players.some(
                    playerId => playerId.toString() === userId.toString()
                ); %>

                <% if (game.createdBy.toString() === userId.toString()) { %>

                    <a
                        href="/games/<%= game._id %>/edit"
                        class="btn btn-outline-primary">

                        Edit Game

                    </a>

                    <form
                        action="/games/<%= game._id %>/delete"
                        method="POST"
                        class="d-inline">

                        <button
                            type="submit"
                            class="btn btn-outline-danger"
                            onclick="return confirm('Are you sure you want to delete this game?');">
                        
                            Delete Game
                        
                        </button>

                    </form>

                <% } %>

                <% if (userJoined) { %>

                    <form action="/games/<%= game._id %>/leave" method="POST">

                        <button
                            type="submit"
                            class="btn btn-outline-danger">

                            Leave Game

                        </button>

                    </form>

                <% } else if (game.players.length >= game.maxPlayers) { %>

                    <button
                        type="button"
                        class="btn btn-secondary"
                        disabled>

                        Game Full

                    </button>

                <% } else { %>

                    <form action="/games/<%= game._id %>/join" method="POST">

                        <button
                            type="submit"
                            class="btn btn-primary">

                            Join Game

                        </button>

                    </form>

                <% } %>

                <a
                    href="/games"
                    class="btn btn-secondary">

                    Back to Games

                </a>

            </div>

        </div>

    </div>

</div>

<%- include("../templates/footer") %>