<%- include("../templates/header") %>

<%- include("../templates/navbar") %>

<div class="content quiz-background">

    <div class="card shadow-sm quiz-card">

        <div class="card-body p-4 p-md-5">

            <h1 class="display-6">Test Your Knowledge</h1>

            <div class="d-flex justify-content-between align-items-center mb-3">

                <span class="text-muted">
                    Question <%= questionNumber %> of <%= totalQuestions %>
                </span>

            </div>

            <div class="progress mb-5" style="height: 8px;">

                <div
                    class="progress-bar"
                    role="progressbar"
                    style="--progress: <%= (questionNumber / totalQuestions) * 100 %>%">
                </div>

            </div>

            <h2 class="mb-4">
                <%= question.question %>
            </h2>

            <form action="/quiz/answer" method="POST">

                <div class="quiz-options">

                    <% question.options.forEach((option, index) => { %>

                        <div class="form-check quiz-option">

                            <input
                                class="form-check-input"
                                type="radio"
                                name="answer"
                                value="<%= option %>"
                                id="option<%= index %>"
                                required
                            >

                            <label
                                class="form-check-label"
                                for="option<%= index %>">

                                <%= option %>

                            </label>

                        </div>

                    <% }) %>

                </div>

                <button
                    type="submit"
                    class="btn btn-primary quiz-next-btn mt-4">

                    <% if (questionNumber === totalQuestions) { %>
                        Finish Quiz
                    <% } else { %>
                        Next
                    <% } %>

                </button>

            </form>

        </div>

    </div>

</div>

<%- include("../templates/footer") %>