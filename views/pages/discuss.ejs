<%- include("../templates/header") %>

<%- include("../templates/navbar") %>

<div class="content">
    <h2 class="display-5">Sports Discussions</h2>

    <p class="lead">
        Join the conversation or start your own discussion.
    </p>

    <div class="row g-4 mt-4">

    <% sports.forEach(sport => { %>

    <div class="col-lg-4 col-md-6 col-sm-12">

        <a href="/discuss/<%= sport.name.toLowerCase() %>" class="text-decoration-none">

            <div class="card page-buttons sport-card shadow-sm">

                <img 
                    src="<%= sport.image %>" 
                    class="sport-card-image" 
                    alt="<%= sport.name %>"
                >

                <div class="sport-card-overlay"></div>

                <div class="sport-card-content">
                    <h3>
                         <%= sport.name %>
                    </h3>

                    <p>
                        <%= sport.description %>
                    </p>
                </div>

            </div>

        </a>

    </div>

    <% }) %>

</div>

</div>

<%- include("../templates/footer") %>